#!/usr/bin/env python3
"""Backup detector for cursor-agent / cursor-run Bash calls. Always exits 0.

Registered later on PreToolUse, PostToolUse, and PostToolUseFailure.
Monitoring only: it never blocks the tool call.
"""

import json
import os
import re
import stat
import sys
import time

sys.dont_write_bytecode = True

_CURSOR_CMD = re.compile(r"(?:^|[\s;&|/])cursor-(?:agent|run)\b")
_SNAPSHOT_MAX_AGE = 24 * 60 * 60
_NO_SNAPSHOT = "control-check: no pre-run snapshot; control plane not compared"


def _state_dir() -> str:
    return os.path.join(os.path.expanduser("~"), ".claude", "state", "control-check")


def _project() -> str:
    raw = os.environ.get("CLAUDE_PROJECT_DIR")
    if raw:
        return os.path.realpath(raw)
    return os.path.realpath(os.getcwd())


def _emit(event, text: str) -> None:
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": event,
            "additionalContext": text,
        }
    }), flush=True)


def _sweep(state_dir: str) -> None:
    if not os.path.isdir(state_dir):
        return
    now = time.time()
    try:
        names = os.listdir(state_dir)
    except OSError:
        return
    for name in names:
        path = os.path.join(state_dir, name)
        try:
            info = os.stat(path)
        except OSError:
            continue
        if not stat.S_ISREG(info.st_mode):
            continue
        if now - info.st_mtime > _SNAPSHOT_MAX_AGE:
            try:
                os.unlink(path)
            except OSError:
                pass


def _snapshot_path(tool_use_id) -> str | None:
    if not isinstance(tool_use_id, str) or not tool_use_id:
        return None
    if tool_use_id in (".", "..") or "/" in tool_use_id or "\\" in tool_use_id:
        return None
    return os.path.join(_state_dir(), tool_use_id + ".json")


def _write_snapshot(path: str, payload: dict) -> None:
    directory = os.path.dirname(path)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    os.chmod(directory, 0o700)
    data = (json.dumps(payload, sort_keys=True) + "\n").encode("utf-8")
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.write(fd, data)
    finally:
        os.close(fd)
    os.chmod(path, 0o600)


def _load_control():
    root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    if root not in sys.path:
        sys.path.insert(0, root)
    import _control
    return _control


def _command(payload: dict) -> str | None:
    tool_input = payload.get("tool_input")
    if not isinstance(tool_input, dict):
        return None
    command = tool_input.get("command")
    if not isinstance(command, str):
        return None
    return command


def _post(event, tool_use_id, control) -> None:
    path = _snapshot_path(tool_use_id)
    if path is None or not os.path.isfile(path):
        _emit(event, _NO_SNAPSHOT)
        return
    try:
        with open(path, encoding="utf-8") as handle:
            before = json.load(handle)
        if not isinstance(before, dict):
            raise ValueError("snapshot is not an object")
        after = control.hash_control_plane(_project())
        changed = control.diff_hashes(before, after)
    except Exception as exc:
        _emit(event, f"control-check could not hash the control plane: {exc}")
        try:
            os.unlink(path)
        except OSError:
            pass
        return
    try:
        os.unlink(path)
    except OSError:
        pass
    if changed:
        listed = ", ".join(changed)
        _emit(
            event,
            "CONTROL PLANE CHANGED during this cursor run: "
            f"{listed}. Stop and ask the user before continuing.",
        )


def _act(payload: dict) -> int:
    if payload.get("tool_name") != "Bash":
        return 0
    command = _command(payload)
    if command is None or _CURSOR_CMD.search(command) is None:
        return 0
    try:
        control = _load_control()
    except Exception as exc:
        print(f"control-check: could not import _control: {exc}", file=sys.stderr)
        return 0

    state_dir = _state_dir()
    _sweep(state_dir)
    event = payload.get("hook_event_name")
    tool_use_id = payload.get("tool_use_id")
    if event == "PreToolUse":
        path = _snapshot_path(tool_use_id)
        if path is None:
            return 0
        try:
            hashes = control.hash_control_plane(_project())
            _write_snapshot(path, hashes)
        except Exception as exc:
            print(f"control-check: could not hash the control plane: {exc}", file=sys.stderr)
        return 0
    if event in ("PostToolUse", "PostToolUseFailure"):
        _post(event, tool_use_id, control)
    return 0


def main() -> int:
    try:
        raw = sys.stdin.read()
    except Exception:
        return 0
    try:
        payload = json.loads(raw)
    except Exception:
        return 0
    if not isinstance(payload, dict):
        return 0

    # Cursor is allowed before any local import, including when this file
    # has been copied alone and _control.py cannot be imported.
    version = payload.get("cursor_version")
    if isinstance(version, str) and version.strip():
        if payload.get("hook_event_name") == "preToolUse":
            print(json.dumps({"permission": "allow"}), flush=True)
        return 0

    _sweep(_state_dir())
    try:
        return _act(payload)
    except Exception as exc:
        print(f"control-check: {exc}", file=sys.stderr)
        return 0


if __name__ == "__main__":
    sys.exit(main())
