{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_WORKFLOW_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "4",
    "CLAUDE_CODE_PLUGIN_DIRS": "/Users/wujincheng/.claude/mods/opus-workflow-spawn"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/wujincheng/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/wujincheng/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/.claude/skills/wf-refactor-skill-names/scripts/check_skill_name_hook.py\" 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Checking skill name"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|mcp__mcp-obsidian__obsidian_put_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/validate-vault.py\" --post"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/bin/control-check\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/wujincheng/.config/iterm2/cc-status"
          }
        ]
      }
      ,
      {
        "matcher": "Agent|SendMessage|Bash|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/opus-arbitration-post.py\"",
            "onFailure": "continue",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/bin/control-check\""
          }
        ]
      }
      ,
      {
        "matcher": "Agent|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/opus-arbitration-post.py\"",
            "onFailure": "continue",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|mcp__mcp-obsidian__obsidian_(put_content|append_content|patch_content)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/require-cursor-agent.py\"",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|mcp__mcp-obsidian__obsidian_(put_content|append_content|patch_content)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/validate-vault.py\" --pre",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/bin/control-check\"",
            "onFailure": "continue"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit|Bash|mcp__mcp-obsidian__.*|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_ROUTING_SCOPE=all-writes python3 \"$HOME/.claude/hooks/route-tools.py\"",
            "onFailure": "continue"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/wujincheng/.config/iterm2/cc-status"
          }
        ]
      }
      ,
      {
        "matcher": "Agent|Task|SendMessage|Workflow|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/opus-arbitration-gate.py\"",
            "onFailure": "block",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/opus-workflow-guard.py\"",
            "onFailure": "block",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/wujincheng/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/routing-context.py\"",
            "onFailure": "continue"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/wujincheng/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/wujincheng/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/wujincheng/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/opus-workflow-guard.py\"",
            "onFailure": "continue",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/wujincheng/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/opus-workflow-guard.py\"",
            "onFailure": "continue",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/wujincheng/.config/iterm2/cc-status"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "slack@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "theme": "dark",
  "model": "opus",
  "permissions": {
    "defaultMode": "plan"
  }
}
